# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local a GitHub ni lo compartas.

# Base de datos (Supabase → Project Settings → Database)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Panel de administración
ADMIN_PANEL_PASSWORD="una-contraseña-larga-y-unica"
# Opcional pero recomendado: secreto para firmar la sesión del panel (≥ 32 caracteres aleatorios)
ADMIN_SESSION_SECRET=""
# Emails (separados por comas) que tienen rol admin además de app_metadata.role = 'admin'
ADMIN_EMAILS="tu-email@ejemplo.com"

# URL pública del sitio (SEO / enlaces de correo)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
